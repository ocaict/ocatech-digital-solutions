{
  "name": "ict",
  "main": "./functions/worker.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ocatech_db",
      "database_id": "41e62e3c-4ec6-4031-bfa0-26b333cfec86"
    }
  ]
}
