{
  "name": "ict",
  "main": "./functions/worker.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}

// D1 is optional for chat replies. Create it in Cloudflare, run db/schema.sql,
// then add the binding in the dashboard. To keep it across Wrangler deploys,
// copy the d1_databases block Cloudflare shows into this file as well.
